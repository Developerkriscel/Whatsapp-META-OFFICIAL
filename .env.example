# ================================================
# WhatsApp SaaS Platform - Environment Variables
# ================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (PostgreSQL - Neon)
DATABASE_URL=postgresql://neondb_owner:npg_NgahWy2Q4KFj@ep-twilight-truth-aihyiq94-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_get_this_from_stripe_cli_or_dashboard
STRIPE_MOCK_MODE=false

# Stripe Price IDs (run `pnpm stripe:setup` or create manually in Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_replace_after_setup
STRIPE_PRICE_GROWTH_MONTHLY=price_replace_after_setup
STRIPE_PRICE_BUSINESS_MONTHLY=price_replace_after_setup
STRIPE_PRICE_STARTER_ANNUAL=price_replace_after_setup
STRIPE_PRICE_GROWTH_ANNUAL=price_replace_after_setup
STRIPE_PRICE_BUSINESS_ANNUAL=price_replace_after_setup

# Stripe Webhook Events to Listen
STRIPE_WEBHOOK_EVENTS=checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed

# WhatsApp Meta API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-system-user-access-token
META_WABA_ID=your-whatsapp-business-account-id
META_PHONE_NUMBER_ID=your-phone-number-id
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_MOCK_MODE=true

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
