{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6",
    "@prisma/client": "^5.9.0",
    "@whatsapp-saas/config": "workspace:*",
    "@whatsapp-saas/shared": "workspace:*",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "4",
    "ioredis": "^5.3.2",
    "pdfkit": "^0.15.0",
    "puppeteer": "^25.3.0",
    "stripe": "^14.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.13.4",
    "esbuild-windows-64": "^0.15.18",
    "prisma": "^5.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
